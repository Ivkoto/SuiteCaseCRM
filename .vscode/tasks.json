{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SuiteCase: Start development stack",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/SuiteCase.Server/SuiteCase.Server.csproj",
        "--launch-profile",
        "https"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
