# .gitignore for MySalesTracker (.NET, Blazor, EF Core)

# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.cursorrules
DeleteBinObjFolders.bat
AGENTS.md

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
# NuGet Packages folder
packages/
# NuGet Symbol Packages
*.snupkg

# Entity Framework Migrations
# MySalesTracker.Data/Migrations/*Designer.cs
# MySalesTracker.Data/Migrations/*Snapshot.cs

# Logs
*.log

# Test results
**/TestResults/
*.trx

# OS generated files
.DS_Store
Thumbs.db

# Others
*.vspscc
*.vssscc

# Ignore secrets/configs (if any)
appsettings.*.local.json
appsettings.Production.json

# Ignore publish profiles (deployment-specific)
**/Properties/PublishProfiles/
 
# VS cache 
.vs/
